{
  "name": "auth-server",
  "version": "1.0.0",
  "description": "Authentication server with Kaapi and Saurbit",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsdown src/*.ts src/**/*.ts --format esm --out-dir dist --clean --sourcemap --unbundle --no-fixed-extension",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/vision": "^7.0.3",
    "@kaapi/kaapi": "^0.0.48",
    "@kaapi/oauth2-auth-design": "^0.0.48",
    "@kaapi/validator-zod": "^0.0.48",
    "@novice1/api-doc-generator": "^1.2.x",
    "@saurbit/oauth2": "^0.1.14",
    "@saurbit/oauth2-jwt": "^0.1.10",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pug": "^3.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pug": "^2.0.10"
  }
}