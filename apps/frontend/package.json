{
  "name": "frontend",
  "version": "1.0.0",
  "description": "Frontend for MCP client chatbot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsdown src/*.ts src/**/*.ts --format esm --out-dir dist --clean --sourcemap --unbundle --no-fixed-extension",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}