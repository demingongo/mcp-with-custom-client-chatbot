{
  "name": "mcp-server-with-auth",
  "version": "1.0.0",
  "description": "MCP server with OpenID Connect authentication",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsdown src/*.ts src/**/*.ts --format esm --out-dir dist --clean --sourcemap --unbundle --no-fixed-extension",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@kaapi/kaapi": "^0.0.51",
    "@kaapi/logger-pino": "^0.0.51",
    "@kaapi/validator-zod": "^0.0.51",
    "@novice1/api-doc-generator": "^1.2.x",
    "hapi-scalar": "^1.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10"
  }
}